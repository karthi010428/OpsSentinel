{
  "name": "opssentinel-root",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=@opssentinel/api",
    "dev:web": "npm run dev --workspace=@opssentinel/web",
    "build:api": "npm run build --workspace=@opssentinel/api",
    "build:web": "npm run build --workspace=@opssentinel/web",
    "test": "npm run test --workspace=@opssentinel/api"
  },
  "devDependencies": {
    "prettier": "^3.3.3"
  }
}